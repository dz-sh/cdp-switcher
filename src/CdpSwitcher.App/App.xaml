<Application
    x:Class="CdpSwitcher.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CdpSwitcher.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <local:TagColorBrushConverter
                x:Key="TagBackgroundBrush" />
            <local:TagColorBrushConverter
                x:Key="TagForegroundBrush"
                UseContrastingForeground="True" />
            <Style
                x:Key="PageTitleTextStyle"
                BasedOn="{StaticResource TitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style
                x:Key="SectionTitleTextStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style
                x:Key="EyebrowTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <DataTemplate x:Key="TagChipTemplate">
                <Border
                    Margin="0,0,6,4"
                    Padding="9,3"
                    Background="{Binding Color, Converter={StaticResource TagBackgroundBrush}}"
                    CornerRadius="12">
                    <TextBlock
                        Foreground="{Binding Color, Converter={StaticResource TagForegroundBrush}}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Name}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
