<Window
    x:Class="CdpSwitcher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CdpSwitcher.App"
    Title="CDP Switcher">

    <Grid
        Padding="36,28,36,32"
        RowSpacing="20"
        UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                Style="{StaticResource PageTitleTextStyle}"
                Text="CDP Switcher" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Choose which isolated Chrome profile is available through the fixed CDP endpoint."
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="20,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="SESSION" />
                    <TextBlock
                        x:Name="StatusText"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Stopped"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        x:Name="CurrentSessionTags"
                        ItemTemplate="{StaticResource TagChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="127.0.0.1:9222" />
                </StackPanel>

                <Button
                    x:Name="StopButton"
                    Grid.Column="1"
                    Click="StopButton_Click"
                    Content="Stop"
                    IsEnabled="False"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Margin="0,2,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="Profiles"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="RemovedProfilesButton"
                    Grid.Column="1"
                    Click="RemovedProfilesButton_Click"
                    Content="Removed profiles"
                    Visibility="Collapsed" />
                <Button
                    x:Name="AddProfileButton"
                    Grid.Column="2"
                    Click="AddProfileButton_Click"
                    Content="Add profile" />
            </Grid>

            <ListView
                x:Name="ProfileList"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind Profiles, Mode=OneWay}">
                <ListView.Header>
                    <Grid
                        x:Name="EmptyState"
                        MinHeight="240">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="No profiles yet" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Choose Add profile to create one." />
                        </StackPanel>
                    </Grid>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style
                        BasedOn="{StaticResource DefaultListViewItemStyle}"
                        TargetType="ListViewItem">
                        <Setter
                            Property="HorizontalContentAlignment"
                            Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="64" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate
                        x:DataType="local:ProfileListItemViewModel">
                        <Grid
                            Padding="10,8"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneWay}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource TagChipTemplate}"
                                    ItemsSource="{x:Bind Tags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="{x:Bind RelationshipLabel, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="SelectedProfilePanel"
                Grid.Row="2"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <Grid
                    ColumnSpacing="16"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock
                            Style="{StaticResource EyebrowTextStyle}"
                            Text="SELECTED PROFILE" />
                        <TextBlock
                            x:Name="SelectedProfileName"
                            Style="{StaticResource SectionTitleTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl
                        x:Name="SelectedProfileTags"
                        Grid.Row="1"
                        ItemTemplate="{StaticResource TagChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="EditButton"
                            Click="EditButton_Click"
                            Content="Edit"
                            IsEnabled="False"
                            MinWidth="72" />
                        <Button
                            x:Name="RemoveButton"
                            Click="RemoveButton_Click"
                            Content="Remove..."
                            IsEnabled="False"
                            MinWidth="88" />
                        <Button
                            x:Name="ActivateButton"
                            Click="ActivateButton_Click"
                            Content="Activate"
                            IsEnabled="False"
                            MinWidth="88"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
